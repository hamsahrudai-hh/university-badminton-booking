# ========================================================
# University Badminton Court Booking System
# Environment Variables Template (.env.example)
#
# Create a local .env file by copying this template:
# Copy-Item .env.example .env
# ========================================================

# --------------------------------------------------------
# 1. MySQL Database Configuration
# --------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=badminton_booking
MYSQL_USER=badminton_user
MYSQL_PASSWORD=change_this_to_a_secure_app_password
MYSQL_ROOT_PASSWORD=change_this_to_a_secure_root_password

# --------------------------------------------------------
# 2. Registration & Email Verification Configuration
# --------------------------------------------------------
# Permitted domain for student registration (case-insensitive check)
ALLOWED_EMAIL_DOMAIN=vitapstudent.ac.in

# Token lifetime in hours before expiration
VERIFICATION_TOKEN_EXPIRY_HOURS=24

# Email delivery mode:
# - dev: logs verification link and token safely to console (no external network call)
# - smtp: sends actual emails via configured SMTP server
APP_EMAIL_PROVIDER=dev
APP_EMAIL_VERIFICATION_BASE_URL=http://localhost:8081

# --------------------------------------------------------
# 3. JWT Authentication & Ownership Security
# --------------------------------------------------------
# Cryptographic secret key used to sign and verify HMAC-SHA256 JWT tokens.
# SECURITY REQUIREMENT: Must be at least 256 bits (32 bytes) in length.
# In production, use a high-entropy cryptographically random string (e.g. openssl rand -base64 48).
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long

# JWT token expiration window in hours (enforced authoritatively on the server)
JWT_EXPIRY_HOURS=24

# --------------------------------------------------------
# 4. Automatic No-Show Processing Scheduler
# --------------------------------------------------------
# Flag to enable/disable the background scheduler that periodically detects and
# penalizes players who failed to check in within the 10-minute grace period.
# SAFETY DEFAULT: false (prevents unintended penalties against existing records on startup).
# To enable locally: APP_NO_SHOW_SCHEDULER_ENABLED=true
# To disable immediately: APP_NO_SHOW_SCHEDULER_ENABLED=false
APP_NO_SHOW_SCHEDULER_ENABLED=false

# Cron expression for background run frequency (default: once per minute)
APP_NO_SHOW_SCHEDULER_CRON=0 * * * * *

# --------------------------------------------------------
# Security Architecture & Token Storage Trade-offs
# --------------------------------------------------------
# 1. Bearer Token vs httpOnly Cookie:
#    - Current Implementation: Authorization: Bearer <token> stored in client memory / localStorage.
#      * Advantage: Works seamlessly with decoupled Vite SPA dev servers and REST APIs without
#        cross-origin cookie (CORS credentials) or SameSite attribute hurdles.
#      * Trade-off: Sensitive to Cross-Site Scripting (XSS). In high-assurance production environments,
#        httpOnly, Secure, SameSite=Strict cookies with CSRF tokens are recommended.
# 2. Server-side Stale Token Safeguards:
#    - Every authenticated request verifies the account against the database via JwtAuthenticationFilter.
#    - Deactivated (active=false) or deleted accounts are immediately rejected with HTTP 401,
#      preventing stale or revoked tokens from accessing the system even before their JWT expiration.
#    - User roles are loaded live from the database, ensuring instantaneous role updates.
