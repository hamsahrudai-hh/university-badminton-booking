# ==========================================
# University Badminton Court Booking System
# .gitignore
# ==========================================

# ------------------------------------------
# Environment Variables, Secrets & Credentials
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
secrets/

# ------------------------------------------
# Backend: Java, Maven & Spring Boot
# ------------------------------------------
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------
# Frontend: Node, React, Vite & TypeScript
# ------------------------------------------
node_modules/
dist/
dist-ssr/
build/
coverage/
.vite/
*.tsbuildinfo
.eslintcache

# Logs & npm artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Docker & Local Container Volumes
# ------------------------------------------
mysql-data/
rabbitmq-data/
docker-data/

# ------------------------------------------
# IDEs & Code Editors
# ------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans

# NetBeans
/nbproject/private/
/build/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ------------------------------------------
# Operating System Files
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------
# Temporary / Scratch Files
# ------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.swp
*~
